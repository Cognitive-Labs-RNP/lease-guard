# ============================================================================
# LeaseGuard AI - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the required values.
# DO NOT commit .env to version control.

# ============================================================================
# Streamlit Configuration
# ============================================================================
STREAMLIT_SERVER_HEADLESS=true

# ============================================================================
# Supabase Configuration
# Required: PostgreSQL database, authentication, and storage
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard
# ============================================================================

# Supabase project URL (example: https://your-project.supabase.co)
SUPABASE_URL=

# Supabase anonymous key (anon or public key)
# Use the anonymous key for client-side authentication
SUPABASE_KEY=

# Optional: Supabase service role key (for admin operations)
# WARNING: Keep this secret; do not expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# AI Provider Configuration
# At least ONE of the following must be configured:
# ============================================================================

# Google Gemini API Key (for lease/invoice extraction via RocketRide)
# Get from: https://ai.google.dev/
ROCKETRIDE_GEMINI_KEY=

# Groq API Key (fallback for lease extraction)
# Get from: https://console.groq.com/
ROCKETRIDE_GROQ_KEY=

# Groq base URL (required if using Groq)
# Example: https://api.groq.com/openai/v1
ROCKETRIDE_GROQ_BASE_URL=

# ============================================================================
# RocketRide Platform Configuration
# For pipeline orchestration and data extraction
# ============================================================================

# RocketRide development/local workspace URI
# (if using RocketRide CLI locally)
ROCKETRIDE_URI=

# RocketRide development API key
ROCKETRIDE_APIKEY=

# RocketRide deployment target URI
# (if deploying extracted pipelines)
ROCKETRIDE_DEPLOY_URI=

# RocketRide deployment API key
ROCKETRIDE_DEPLOY_APIKEY=

# ============================================================================
# Demo Mode Configuration
# ============================================================================

# Set to "true" to enable demo mode with sample data
# Useful for testing without external services
DEMO_MODE=false
